{
  "slug": "gapgpt",
  "name": "گپ جی‌پی‌تی (GapGPT)",
  "type": "gapgpt",
  "baseurl": "https://api.gapgpt.app/v1",
  "driver": "GapGPTDriver",
  "actions": ["chat", "models", "responses", "images", "speech", "embeddings"],
  "default_model": "gpt-4o-mini",
  "models": [
    {"model_id": "gpt-4o-mini", "name": "GPT-4o Mini", "fallback": null, "default": true},
    {"model_id": "gpt-4o", "name": "GPT-4o", "fallback": "gpt-4o-mini"},
    {"model_id": "gemini-2.5-pro", "name": "Gemini 2.5 Pro", "fallback": "gpt-4o-mini"},
    {"model_id": "claude-sonnet-5", "name": "Claude Sonnet 5", "fallback": "gpt-4o-mini"}
  ]
}
