# ============================================================
# Mizban AI Gateway — Environment Configuration
# ============================================================
# Copy this file to `.env` (in the same directory as config.php)
# and fill in real values. config.php reads this file automatically.
#
#   cp .env.example .env
#
# NEVER commit the real `.env` file.

# ---- Application ----
MIZBAN_HOST_NAME=Mizban
MIZBAN_DEBUG=false
MIZBAN_TIMEZONE=Asia/Tehran

# ---- Database (MySQL / MariaDB) ----
MIZBAN_DB_HOST=localhost
MIZBAN_DB_NAME=mizban
MIZBAN_DB_USER=mizban
MIZBAN_DB_PASS=CHANGE_ME_STRONG_DB_PASSWORD
MIZBAN_DB_CHARSET=utf8mb4

# ---- Security ----
# REQUIRED in production. 64+ random characters.
# Generate one with:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# or: openssl rand -hex 32
MIZBAN_MASTER_SECRET=CHANGE_ME_64_CHAR_RANDOM_HEX

# Random token that protects cron endpoints called over HTTP.
# Generate one with: openssl rand -hex 16
MIZBAN_CRON_TOKEN=CHANGE_ME_RANDOM_CRON_TOKEN

# Default admin bootstrap account (created only on first run).
# Change it from the admin panel after the first login.
MIZBAN_ADMIN_USER=admin
MIZBAN_ADMIN_PASSWORD=admin123

# ---- CORS ----
# Comma-separated list of allowed browser origins that may call the
# JSON API directly (admin panel is same-origin, so it does not need
# to be listed). Leave empty to disallow all cross-origin browser calls.
MIZBAN_CORS_ORIGINS=

# ---- Optional: Boroto developer console (boroto.php) ----
# Protects proxy + log endpoints. Leave empty to disable them.
# Generate: openssl rand -hex 16
BOROTO_TOKEN=
